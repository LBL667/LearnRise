# Offline demo profile (no secrets, no external AI keys).
#
#   docker compose up -d          # picks these values up automatically
#   docker compose --env-file .env.demo up -d   # or load this file explicitly
#
# Production deployments must override LLM_PROVIDER / EMBEDDING_PROVIDER with a
# real OpenAI-compatible endpoint plus keys, e.g.:
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_API_KEY=<from the secret manager>
LLM_PROVIDER=mock
LLM_MODEL=mock-local
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-hash
EMBEDDING_DIM=1024

PROVIDER_PROFILE=local
STORAGE_PROVIDER=local
TIMEZONE=Asia/Shanghai

# Demo credentials (already the public demo account in the seed script).
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo1234
