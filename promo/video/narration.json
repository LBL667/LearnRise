  "scenes": [
    {
      "scene": "S01",
      "id": "S01",
      "text": "备考最痛苦的，从来不是没有资料。而是资料看完就忘，错了还错。",
      "textHash": "8a2402f3d5a2968d",
      "audio": "out/audio/yunyang/s01.mp3",
      "duration": 6.288,
      "durationSeconds": 6.288,
      "frames": 213,
      "audioFrames": 189,
      "windowFrames": 360,
      "windowSeconds": 12,
      "characters": 30,
