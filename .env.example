PROVIDER_PROFILE=local
DATABASE_URL=postgresql+psycopg://learnrise:learnrise@localhost:55432/learnrise
# LLM
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
# Embedding
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=var/storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=learnrise
MINIO_SECURE=false
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=
OBS_ENDPOINT=
OBS_BUCKET=
# OCR
OCR_PROVIDER=paddle
OCR_SERVICE_URL=http://localhost:8001
HUAWEI_AK=
HUAWEI_SK=
HUAWEI_PROJECT_ID=
HUAWEI_REGION=cn-north-4
# Auth / security
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
AGENT_SECRET_KEY=dev-only-fernet-key-change-me-32bytes=
AGENT_REQUEST_TIMEOUT_SECONDS=10
# SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
# Reminder / internal
CRON_SIGNATURE_SECRET=dev-only-cron-secret
APP_BASE_URL=http://localhost:5173
TIMEZONE=Asia/Shanghai
# Upload
MAX_UPLOAD_MB=20
